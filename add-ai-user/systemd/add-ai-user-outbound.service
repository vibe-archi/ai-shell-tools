[Unit]
Description=add-ai-user: no new outbound connection for restricted accounts with a remote agent
After=nftables.service
Before=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/add-ai-user/restricted/outbound.nft
ExecStop=-/usr/sbin/nft delete table inet add_ai_user

[Install]
WantedBy=multi-user.target
